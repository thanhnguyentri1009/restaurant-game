# Cấu hình Firebase để lưu tiến trình lên Firestore theo username (không cần đăng nhập).
# Copy file này thành .env rồi điền giá trị lấy từ:
#   Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
# Để trống API_KEY hoặc PROJECT_ID thì game chỉ lưu trên máy (localStorage).
#
# Username do bạn tạo tay trong Firestore: tạo collection tên là username (vd: dinhdinh)
# với một document có ID là "progress". Game sẽ ghi tiến trình vào document đó.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
